    "jsonwebtoken": "^9.0.2",
    "next": "^15.3.0",
    "next-pwa": "^5.6.0",
    "pdf-parse": "^1.1.1",
    "pdfkit": "^0.17.2",
    "prisma": "^5.22.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^2.15.2",
    "tesseract.js": "^6.0.1",
    "tsx": "^4.20.6",
    "uuid": "^11.1.0",
    "xlsx": "^0.18.5",
    "zod": "^3.24.2",
    "zustand": "^5.0.6"
  },
